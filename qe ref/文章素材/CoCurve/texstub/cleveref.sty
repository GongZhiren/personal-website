\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cleveref}[2024/01/01 minimal stub via autoref]
\DeclareOption*{}\ProcessOptions\relax
% Route \cref/\Cref through hyperref's \autoref so references carry type names
% (Figure/Table/Section/Proposition/...) in this constrained build. The real
% cleveref on a full TeX install supersedes this and is what the source targets.
\AtBeginDocument{\providecommand{\figureautorefname}{Figure}\renewcommand{\figureautorefname}{Figure}}
\AtBeginDocument{\providecommand{\tableautorefname}{Table}\renewcommand{\tableautorefname}{Table}}
\AtBeginDocument{\providecommand{\sectionautorefname}{Section}\renewcommand{\sectionautorefname}{Section}}
\AtBeginDocument{\providecommand{\subsectionautorefname}{Section}\renewcommand{\subsectionautorefname}{Section}}
\AtBeginDocument{\providecommand{\subsubsectionautorefname}{Section}\renewcommand{\subsubsectionautorefname}{Section}}
\AtBeginDocument{\providecommand{\algorithmautorefname}{Algorithm}\renewcommand{\algorithmautorefname}{Algorithm}}
\AtBeginDocument{\providecommand{\propositionautorefname}{Proposition}\renewcommand{\propositionautorefname}{Proposition}}
\AtBeginDocument{\providecommand{\lemmaautorefname}{Lemma}\renewcommand{\lemmaautorefname}{Lemma}}
\AtBeginDocument{\providecommand{\remarkautorefname}{Remark}\renewcommand{\remarkautorefname}{Remark}}
\AtBeginDocument{\providecommand{\corollaryautorefname}{Corollary}\renewcommand{\corollaryautorefname}{Corollary}}
\AtBeginDocument{\providecommand{\theoremautorefname}{Theorem}\renewcommand{\theoremautorefname}{Theorem}}
\AtBeginDocument{\providecommand{\definitionautorefname}{Definition}\renewcommand{\definitionautorefname}{Definition}}
\AtBeginDocument{\providecommand{\equationautorefname}{Eq.}\renewcommand{\equationautorefname}{Eq.}}
\def\cref#1{\autoref{#1}}
\def\Cref#1{\autoref{#1}}
\providecommand{\crefname}[3]{}
\providecommand{\Crefname}[3]{}
\providecommand{\creflabelformat}[2]{}
\providecommand{\crefformat}[2]{}
