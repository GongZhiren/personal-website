\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces \textbf  {Surrogate-budget sensitivity} (Llama-3.2-3B at $\rho {=}20\%$, under the deployed guard). Upper block varies top-$r$ at fixed calibration $128$; lower block varies calibration at fixed top-$256$. The default is $(128,256)$. Each build re-derives its own $\hat  \lambda $, so the column shows that the knob does move what the rule selects --- and the pruned model does not follow.}}{46}{table.caption.36}\protected@file@percent }
\newlabel{tab:sensitivity}{{22}{46}{\textbf {Surrogate-budget sensitivity} (Llama-3.2-3B at $\rho {=}20\%$, under the deployed guard). Upper block varies top-$r$ at fixed calibration $128$; lower block varies calibration at fixed top-$256$. The default is $(128,256)$. Each build re-derives its own $\hat \lambda $, so the column shows that the knob does move what the rule selects --- and the pruned model does not follow}{table.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {How much calibration data the selection needs.} Overlap between the units chosen from $n$ sequences and those chosen from the full budget of $128$, mean over three draws. Measuring the selection rather than downstream accuracy separates estimator convergence from benchmark resolution. At the calibrated $\hat  \lambda $ the overlap is consistently higher than at $\lambda {=}1$: damping the off-diagonal, the part of the matrix that needs the most data, also makes the solution easier to estimate.}}{46}{figure.caption.37}\protected@file@percent }
\newlabel{fig:calibbudget}{{7}{46}{\textbf {How much calibration data the selection needs.} Overlap between the units chosen from $n$ sequences and those chosen from the full budget of $128$, mean over three draws. Measuring the selection rather than downstream accuracy separates estimator convergence from benchmark resolution. At the calibrated $\hat \lambda $ the overlap is consistently higher than at $\lambda {=}1$: damping the off-diagonal, the part of the matrix that needs the most data, also makes the solution easier to estimate}{figure.caption.37}{}}
